{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TFT Vision Overlay Catalog",
  "type": "object",
  "required": ["schemaVersion", "patch", "updatedAt", "decks", "augments"],
  "properties": {
    "schemaVersion": {"const": 2},
    "patch": {"type": "string"},
    "updatedAt": {"type": "string"},
    "decks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "teamCode", "units", "levelPlan"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "tier": {"type": "string"},
          "patch": {"type": "string"},
          "teamCode": {"type": "string", "pattern": "^02[0-9a-fA-F]{30}TFTSet17$"},
          "teamCodeSource": {"type": "string"},
          "teamCodeSourceUrl": {"type": "string"},
          "teamBuilderKey": {"type": "string"},
          "sourceLabel": {"type": "string"},
          "sourceUrl": {"type": "string"},
          "sourceMatch": {"type": "number", "minimum": 0, "maximum": 1},
          "averagePlace": {"type": "number", "minimum": 1, "maximum": 8},
          "top4Rate": {"type": "number", "minimum": 0, "maximum": 100},
          "pickRate": {"type": "number", "minimum": 0, "maximum": 100},
          "levelPlan": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 10}},
          "phaseBoards": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "required": ["key", "label", "stage", "units"]
            }
          },
          "substitutions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["out", "in"],
              "properties": {
                "out": {"type": "array", "items": {"type": "string"}},
                "in": {"type": "array", "items": {"type": "string"}},
                "note": {"type": "string"}
              }
            }
          },
          "units": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["championId", "name", "row", "column", "items"],
              "properties": {
                "championId": {"type": "string"},
                "name": {"type": "string"},
                "row": {"type": "integer", "minimum": 0, "maximum": 3},
                "column": {"type": "integer", "minimum": 0, "maximum": 6},
                "star": {"type": "integer", "minimum": 1, "maximum": 4},
                "cost": {"type": "integer", "minimum": 1, "maximum": 9},
                "role": {"type": "string"},
                "recommendedItems": {"type": "array", "items": {"type": "string"}},
                "items": {"type": "array", "maxItems": 3, "items": {"type": "string"}}
              }
            }
          }
        }
      }
    },
    "augments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "tier", "sourceLabel"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "tier": {"enum": ["S", "A", "B", "C"]},
          "description": {"type": "string"},
          "category": {"type": "string"},
          "rarity": {"type": "string"},
          "compatibleDecks": {"type": "array", "items": {"type": "string"}},
          "sourceLabel": {"type": "string"}
        }
      }
    }
  }
}
